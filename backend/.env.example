# Copy to .env and fill in real values. Never commit the actual .env.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-from-supabase-dashboard

# Optional: comma-separated list of allowed CORS origins (Vercel PWA, etc.).
# Wildcards (`*`) are supported per-segment. Leave the default for local dev.
# CORS_ORIGINS=http://localhost:*,http://10.0.2.2:*,http://127.0.0.1:*,https://gastrovoyage.vercel.app
