{
  "name": "gastrovoyage",
  "version": "0.1.0",
  "private": true,
  "description": "GastroVoyage — Interactive World Cuisine Challenge. Monorepo containing the Expo mobile app, Next.js admin panel, and shared packages.",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev:mobile": "pnpm --filter @gastrovoyage/mobile dev",
    "dev:admin": "pnpm --filter @gastrovoyage/admin dev",
    "build:admin": "pnpm --filter @gastrovoyage/admin build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,sql}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,sql}\"",
    "data:countries": "node tools/generate-countries.mjs",
    "data:shapes": "node tools/generate-country-shapes.mjs",
    "db:types": "supabase gen types typescript --linked > packages/shared/src/supabase/types.generated.ts",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "supabase:link": "supabase link --project-ref hhdcohovxegvildfetvy",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "mobile:prebuild": "pnpm --filter @gastrovoyage/mobile exec expo prebuild",
    "mobile:android": "pnpm --filter @gastrovoyage/mobile exec expo run:android",
    "mobile:android:install": "pnpm --filter @gastrovoyage/mobile exec expo run:android -- --no-bundler",
    "mobile:ios": "pnpm --filter @gastrovoyage/mobile exec expo run:ios"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  }
}
